function KpiCard({
  icon: Icon,
  iconClass,
  label,
  value,
  variation,
  positive = true,
  spark,
}: {
  icon: React.ElementType;
  iconClass: string;
  label: string;
  value: string;
  variation?: string;
  positive?: boolean;
  spark: string;
}) {
  return (
    <div className="kpi-card">
      <div className={`kpi-icon ${iconClass}`}>
        <Icon size={21} strokeWidth={2.2} />
      </div>

      <div className="kpi-content">
        <span className="kpi-label">{label}</span>
        <div className="kpi-value-row">
          <strong>{value}</strong>
          {variation && (
            <span className={positive ? "variation positive" : "variation negative"}>
              {positive ? <TrendingUp size={13} /> : <TrendingDown size={13} />}
              {variation}
            </span>
          )}
        </div>
        <span className="kpi-caption">
          Dados atuais do Core
        </span>
      </div>

      <div className="sparkline">
        <svg viewBox="0 0 120 40" preserveAspectRatio="none">
          <defs>
            <linearGradient id={`gradient-${iconClass}`} x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stopColor="currentColor" stopOpacity=".18" />
              <stop offset="100%" stopColor="currentColor" stopOpacity="0" />
            </linearGradient>
          </defs>
          <path
            d={spark}
            fill={`url(#gradient-${iconClass})`}
            stroke="none"
          />
          <path
            d={spark.replace(" L120 40 L0 40", "")}
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            vectorEffect="non-scaling-stroke"
          />
        </svg>
      </div>
    </div>
  );
}

function RevenueChart() {
  const maxValue = 140;
  const chartHeight = 190;
  const chartWidth = 620;

  const points = revenueData.map((item, index) => {
    const x = 45 + index * 104;
    const y = 190 - (item.value / maxValue) * 150;
    return { x, y, ...item };
  });

  const debtPoints = revenueData.map((item, index) => {
    const x = 45 + index * 104;
    const y = 185 - (item.debt / 5) * 145;
    return { x, y };
  });

  const debtPath = debtPoints
    .map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`)
    .join(" ");

  return (
    <div className="revenue-chart">
      <div className="chart-y-labels">
        <span>150K</span>
        <span>120K</span>
        <span>90K</span>
        <span>60K</span>
        <span>30K</span>
        <span>0</span>
      </div>

      <svg
        viewBox={`0 0 ${chartWidth} ${chartHeight + 35}`}
        className="chart-svg"
        role="img"
        aria-label="Gráfico de receita e inadimplência dos últimos seis meses"
      >
        {[18, 52, 86, 120, 154, 188].map((y) => (
          <line
            key={y}
            x1="45"
            y1={y}
            x2="600"
            y2={y}
            className="chart-grid"
          />
        ))}

        {points.map((point) => (
          <rect
            key={point.month}
            x={point.x - 18}
            y={point.y}
            width="36"
            height={190 - point.y}
            rx="5"
            className="chart-bar"
          />
        ))}

        <path d={debtPath} className="debt-line" />

        {debtPoints.map((point) => (
          <circle
            key={`${point.x}-${point.y}`}
            cx={point.x}
            cy={point.y}
            r="4"
            className="debt-dot"
          />
        ))}

        {points.map((point) => (
          <text
            key={`label-${point.month}`}
            x={point.x}
            y="220"
            textAnchor="middle"
            className="chart-month"
          >
            {point.month}
          </text>
        ))}
      </svg>

      <div className="chart-right-labels">
        <span>5%</span>
        <span>4%</span>
        <span>3%</span>
        <span>2%</span>
        <span>1%</span>
        <span>0%</span>
      </div>
    </div>
  );
}

function NetworkStatus({
  dashboard,
  loading,
}: {
  dashboard: DashboardResponse | null;
  loading: boolean;
}) {
  const categories = dashboard
    ? [
        dashboard.status_summary.network_nodes,
        dashboard.status_summary.network_ports,
        dashboard.status_summary.olt_devices,
        dashboard.status_summary.nas_devices,
      ]
    : [];

  const totals = categories.reduce(
    (acc, item) => ({
      healthy: acc.healthy + item.healthy,
      attention: acc.attention + item.attention,
      offline: acc.offline + item.offline,
    }),
    {
      healthy: 0,
      attention: 0,
      offline: 0,
    },
  );

  const monitoredTotal =
    totals.healthy + totals.attention + totals.offline;

  const availability =
    monitoredTotal > 0
      ? (totals.healthy / monitoredTotal) * 100
      : null;

  const networkAssets = dashboard?.metrics.network ?? 0;

  const networkProblems =
    totals.attention +
    totals.offline +
    (dashboard?.alerts.failed_provisioning ?? 0);

  const availabilityText =
    loading || availability === null
      ? "N/D"
      : `${availability.toLocaleString("pt-BR", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        })}%`;

  function Ring({
    value,
    tone,
    label,
    percent,
  }: {
    value: string;
    tone: "green" | "blue" | "orange";
    label: string;
    percent: number;
  }) {
    return (
      <div className={`status-ring ${tone}`}>
        <div>
          <strong>{value}</strong>
          <span>{label}</span>
        </div>

        <style>{`
          .status-ring.${tone}::before {
            background: conic-gradient(
              currentColor 0 ${Math.max(0, Math.min(100, percent))}%,
              #eaf0f6 ${Math.max(0, Math.min(100, percent))}% 100%
            );
          }
        `}</style>
      </div>
    );
  }

  return (
    <div className="network-status">
      <Ring
        value={availabilityText}
        tone="green"
        label="Saúde monitorada"
        percent={availability ?? 0}
      />

      <Ring
        value={
          loading
            ? "—"
            : networkAssets.toLocaleString("pt-BR")
        }
        tone="blue"
        label="Ativos de rede"
        percent={
          networkAssets > 0
            ? 100
            : 0
        }
      />

      <Ring
        value={
          loading
            ? "—"
            : networkProblems.toLocaleString("pt-BR")
        }
        tone="orange"
        label="Atenção / offline"
        percent={
          monitoredTotal > 0
            ? Math.min(
                100,
                (networkProblems / monitoredTotal) * 100,
              )
            : 0
        }
      />
    </div>
  );
}

